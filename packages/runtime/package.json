{
  "name": "@agenterm/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@agenterm/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "get-port": "7.2.0",
    "mitt": "3.0.1",
    "node-pty": "1.1.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "simple-git": "4.0.2",
    "systeminformation": "5.33.13",
    "tree-kill": "1.2.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
