{
  "name": "agenterm",
  "version": "0.1.0",
  "private": true,
  "description": "Local control center for agents, terminals, processes, and workspaces",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-pty-helper.mjs",    "dev": "turbo run dev",
    "dev:daemon": "turbo run dev --filter=@agenterm/runtime",
    "dev:desktop": "turbo run dev --filter=agenterm-desktop",
    "dev:cli": "turbo run dev --filter=agenterm",
    "build": "turbo run build",
    "pack:mac": "turbo run pack --filter=agenterm-desktop",
    "pack:win": "turbo run pack --filter=agenterm-desktop",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "@typescript-eslint/parser": "8.70.1"
  }
}
