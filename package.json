{
  "name": "agenterm",
  "version": "0.1.0",
  "private": true,
  "description": "Local control center for agents, terminals, processes, and workspaces",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-pty-helper.mjs",
    "dev": "turbo run dev",
    "dev:daemon": "turbo run dev --filter=@agenterm/runtime",
    "dev:desktop": "turbo run dev --filter=agenterm-desktop",
    "dev:cli": "turbo run dev --filter=agenterm",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "turbo run pack --filter=agenterm-desktop",
    "dist": "turbo run dist --filter=agenterm-desktop",
    "dev:web": "turbo run dev:web --filter=agenterm-desktop"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
