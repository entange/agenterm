{
  "name": "agenterm-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "lint": "eslint electron src shared --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack": "electron-builder --publish never",
    "start": "electron-vite preview",
    "icons": "node scripts/make-icons.mjs",
    "dev:web": "vite --config vite.web.config.ts"
  },
  "dependencies": {
    "@agenterm/core": "workspace:*",
    "@agenterm/runtime": "workspace:*",
    "@agenterm/ui": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2"
  }
}
