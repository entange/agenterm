{
  "name": "agenterm-desktop",
  "productName": "agenterm",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "lint": "eslint electron src shared --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack": "electron-vite build && node scripts/stage-daemon.mjs && electron-builder --dir --publish never",
    "start": "electron-vite preview",
    "icons": "node scripts/make-icons.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build:daemon": "vite build --config vite.daemon.config.ts",
    "stage:daemon": "node scripts/stage-daemon.mjs",
    "dist": "electron-vite build && node scripts/stage-daemon.mjs --arch arm64,x64 && electron-builder --mac --publish never"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@agenterm/core": "workspace:*",
    "@agenterm/runtime": "workspace:*",
    "@agenterm/ui": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2",
    "zustand": "5.0.15"
  },
  "description": "agenterm desktop: watch, type into, and stop the terminals you and your agents start",
  "author": "Entange",
  "homepage": "https://github.com/entange/agenterm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entange/agenterm.git",
    "directory": "apps/desktop"
  }
}
