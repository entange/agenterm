{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A static site: no Worker code, just the Vite build.
  "name": "agenterm-site",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "agenterm.entange.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
